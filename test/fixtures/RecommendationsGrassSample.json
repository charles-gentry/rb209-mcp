  "adviceNotes": [
    {
      "nutrientId": 0,
      "sequenceId": 1,
      "note": "For early season first-cut rates over 80 kg N/ha, split application: 40 kg N/ha in mid-February to early March, with the remainder in late March to early April and at least six weeks before cutting."
    },
    {
      "nutrientId": 0,
      "sequenceId": 1,
      "note": "Nitrogen requirement and uptake can be heavily influenced by weather conditions, so it is important to continually re-evaluate nitrogen fertiliser requirements throughout the season. If grass growth is restricted due to drought, reduce or omit the use of N once growth restarts following rain. As a guide, if there is no growth for 2 weeks the annual grass yield may be reduced by 1 t/ha of dry matter and there will be about 40 kg/ha of unused N in the soil."
    },
    {
      "nutrientId": 0,
      "sequenceId": 1,
      "note": "The nitrogen recommendations are based on soil nitrogen supply, grass growth class and target yield, and take into account any adjustments recommended in RB209 Section 3."
    },
    {
      "nutrientId": 1,
      "sequenceId": 1,
      "note": "Phosphate for grazing may be applied in several small applications during the season, though there may be a small response if it is all applied in early spring for the first grazing."
    },
    {
      "nutrientId": 2,
      "sequenceId": 1,
      "note": "In one and two cut systems, the recommendation for the last one or two cuts (or grazings if grazings follow cutting) includes the extra 60 kg/ha as recommended in RB209 to balance the potash offtake during the season."
    },
    {
      "nutrientId": 2,
      "sequenceId": 1,
      "note": "Potash for grazing should be applied as 30kg potash per ha for the first grazing, and the remainder in June or July. Where there is a known risk of hypomagnesaemia, application of potash in spring should be avoided."
    },
    {
      "nutrientId": 2,
      "sequenceId": 1,
      "note": "To minimise luxury uptake of potash, no more than 80\u201390 kg potash per ha should be applied in the spring for the first cut. The balance of the recommended rate should be applied in the previous autumn."
    },
    {
      "nutrientId": 3,
      "sequenceId": 1,
      "note": "A new soil analysis is needed. Use of soil analysis results that are more than 4-5 years old may give misleading recommendations."
    },
    {
      "nutrientId": 3,
      "sequenceId": 1,
      "note": "If there is a risk of hypomagnesaemia, 100 kg MgO/ha may be justified to maintain soil magnesium at Index 2."
    }
  ],
  "referenceValue": "grass",
